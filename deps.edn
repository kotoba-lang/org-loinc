;; No third-party dependencies. This library is a check-digit algorithm,
;; a code-shape validator, a plain data shape for the six-axis part model,
;; and a generic CSV reader for a licensee's own release file -- none of
;; that needs anything beyond the language itself, and this repo ships no
;; LOINC content for a dependency to carry.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
